# Database Connection (SQLite default for local prototype; switch to PostgreSQL for team/production deployment)
DATABASE_URL=sqlite:///./ps4.db

# JWT Security
SECRET_KEY=aicte-sih-prototype-secure-token-secret-2026
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Groq AI Document Scrutiny Configuration (Official SIH26262 Integration) ---
# Set GROQ_API_KEY to enable live ultra-fast LLM document review and candidate field extraction via Groq Cloud.
# Recommended models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROVIDER=groq

# Optional alternative fallback providers (OpenAI / Gemini / Anthropic)
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions
