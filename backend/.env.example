# ====================================================================
# PRAVAHA — AICTE Regulatory Workflow & Scrutiny Engine
# Environment Configuration Template (.env.example)
# ====================================================================

# Database Configuration
# Options: 'sqlite' for local offline development, or 'supabase' for Supabase PostgreSQL
DATABASE_PROVIDER=sqlite
DATABASE_URL=sqlite:///./ps4.db

# Supabase / PostgreSQL Production Configuration (Rotate and replace placeholders)
# Session pooler (Port 5432) or Transaction pooler (Port 6543):
# DATABASE_PROVIDER=supabase
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<ROTATED_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
# SUPABASE_URL=https://<PROJECT_REF>.supabase.co
# SUPABASE_ANON_KEY=<ANON_KEY>
# SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>

# JWT Security
SECRET_KEY=aicte-sih-prototype-secure-token-secret-2026
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Document Scrutiny Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROVIDER=groq
