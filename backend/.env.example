# Database Connection (SQLite default for local prototype; switch to PostgreSQL for team/production deployment)
DATABASE_URL=sqlite:///./ps4.db

# JWT Security
SECRET_KEY=aicte-sih-prototype-secure-token-secret-2026
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI / LLM Configuration
# Set AI_PROVIDER to 'openai' or 'gemini' and provide an API key to enable live LLM document review.
# If left as 'none' or without an API key, the system automatically uses the built-in deterministic demo review mode.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1/chat/completions
